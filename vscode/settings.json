{
  // ==========================================
  // THEME & AESTHETICS (Ghostty / Catppuccin)
  // ==========================================
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Catppuccin Mocha",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "symbols", // Monochrome, extremely minimal icons
  "workbench.productIconTheme": "Default",
  "workbench.colorCustomizations": {
    // Flatten tabs to look more like Zed
    "tab.border": "#00000000",
    "editorGroupHeader.tabsBorder": "#00000000",
    "statusBar.border": "#00000000",
    "sideBar.border": "#00000000",
    "sideBarSectionHeader.border": "#00000000",
  },

  // ==========================================
  // TYPOGRAPHY (Zed Parity)
  // ==========================================
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Menlo', monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.fontLigatures": true,
  "editor.letterSpacing": 0.5,
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",

  // ==========================================
  // CHROME REDUCTION (Minimalism)
  // ==========================================
  "workbench.activityBar.location": "hidden", // Reclaim horizontal space; use keyboard to toggle panels
  "workbench.layoutControl.enabled": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.tabActionLocation": "left",
  "workbench.editor.tabCloseButton": "off", // Cleaner tabs, use Cmd+W to close
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden", // Zed style
  "editor.scrollbar.horizontal": "hidden",
  "editor.guides.indentation": false,
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "gutter", // Less intrusive line highlight
  "editor.matchBrackets": "never", // Reduces jumping visual noise
  "editor.inlayHints.enabled": "offUnlessPressed", // Press Ctrl/Cmd to see them
  "editor.codeLens": false,

  // Status Bar Diet
  "window.commandCenter": false,
  "workbench.statusBar.visible": true,

  // ==========================================
  // FILE EXPLORER
  // ==========================================
  "workbench.sideBar.location": "left",
  "explorer.compactFolders": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.autoReveal": false,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.elixir_ls": true,
    "**/_build": true,
    "**/deps": true,
  },

  // ==========================================
  // TERMINAL (Ghostty Parity)
  // ==========================================
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.macOptionIsMeta": true, // Respect Option as Alt for Zsh/Tmux inside VS Code
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.tabs.enabled": false, // Use tmux or standard VS Code panel switching

  // ==========================================
  // PERFORMANCE & BEHAVIOR
  // ==========================================
  "window.restoreWindows": "none", // Open clean
  "workbench.startupEditor": "none", // No welcome page
  "files.autoSave": "afterDelay",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.formatOnSave": true,
  "search.smartCase": true,
  "search.useIgnoreFiles": true,

  // ==========================================
  // PRIVACY & DATA SHARING LOCKDOWN
  // ==========================================
  "telemetry.telemetryLevel": "off",
  "telemetry.macMachineId": "",
  "telemetry.machineId": "",
  "redhat.telemetry.enabled": false,
  "java.help.firstView": "none",
  "java.help.showReleaseNotes": false,
  "elixirLS.telemetryEnabled": false,
  "update.mode": "none",
  "update.showReleaseNotes": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "workbench.settings.enableNaturalLanguageSearch": false,
  "editor.aiStats.enabled": false,
  "github.copilot.enable": { "*": false },
  "json.schemaDownload.enable": false,
  "security.workspace.trust.enabled": true,

  // ==========================================
  // LANGUAGE SPECIFICS (Backend)
  // ==========================================
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" },
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
  },
  "[elixir]": {
    "editor.defaultFormatter": "JakeBecker.elixir-ls",
  },
  "[typescript][javascript][json][yaml][html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.editor.tabActionCloseVisibility": false,
}
