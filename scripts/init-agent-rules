#!/bin/zsh
set -e

PROJECT_DIR="${1:-.}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
SOURCE="$HOME/.config/awesome-dev-setup/AGENTS.md"
TARGET="$PROJECT_DIR/AGENTS.md"

if [[ ! -f "$SOURCE" ]]; then
    echo "Error: $SOURCE not found."
    echo "Run bootstrap.sh first."
    exit 1
fi

if [[ -e "$TARGET" ]]; then
    echo "AGENTS.md already exists: $TARGET"
    echo "Refusing to overwrite it."
    exit 1
fi

cp "$SOURCE" "$TARGET"
echo "Created: $TARGET"
